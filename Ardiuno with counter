#include <WiFiS3.h>
#include <Wire.h>
#include <Pixy2I2C.h>

// WiFi Credentials 
char ssid[] = "AutonomeSysteme";
char pass[] = "Kennwort1";
WiFiServer server(80);

// Motor
Pixy2I2C pixy;
#define ITG3205_ADDR 0x68
#define ENA 5
#define ENB 6
#define IN1 A1
#define IN2 A0
#define IN3 A2
#define IN4 A3

// Pixy camera and speed control for alphabot position
int baseSpeed = 90;
int sideOffset = 24;
const int frameCenter = 39;// total x coordinate frame width is 79.

// Gyro 
float yawAngle = 0;
float currentYawRate = 0;
float gyroOffsetZ = 0;
unsigned long lastMicros = 0;
unsigned long sendCounter = 0;

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  // 1. Initialize Gyro (ITG3205)
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x3E); Wire.write(0x00); Wire.endTransmission();
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x16); Wire.write(0x1D); Wire.endTransmission();

  // 2. Calibrate Gyro (Robot must be stationary)
  Serial.println("Calibrating Gyro");
  long sumZ = 0;
  for (int i = 0; i < 500; i++) { 
    sumZ += readRawGyroZ(); 
    delay(2); 
  }
  gyroOffsetZ = sumZ / 500.0;

  // 3. Initialize Pixy & Motors
  pixy.init();
  pixy.changeProg("line");
  pinMode(ENA, OUTPUT); pinMode(ENB, OUTPUT);
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);

  // 4. WiFi Connection
  Serial.print("Connecting to WiFi...");
  WiFi.begin(ssid, pass);
  while (WiFi.status() != WL_CONNECTED) { 
    delay(0); 
    Serial.print("."); 
  }
  server.begin();

  lastMicros = micros();
  Serial.println("\nRobot Online! IP Address: " + WiFi.localIP().toString());
}

void loop() {
  calculatePassiveGyro();
  followLine();
  handleWiFiClient();
}

void calculatePassiveGyro() {
  unsigned long now = micros();
  float dt = (now - lastMicros) / 1000000.0;
  lastMicros = now;

  // Sensitivity for ITG3205 is 14.375 LSB per degree/sec
  currentYawRate = (readRawGyroZ() - gyroOffsetZ) / 14.375;
  yawAngle += currentYawRate * dt;
}

void followLine() {
  pixy.line.getMainFeatures();
  
  // Check if a line is actually detected
  if (pixy.line.numVectors <= 0) { 
    setMotor(0, 0); 
    return; 
  }

  //  Accessing the first vector in the array using [0]
  int x0 = pixy.line.vectors[0].m_x0;
  int x1 = pixy.line.vectors[0].m_x1;
  int lineCenter = (x0 + x1) / 2;
  
  int target = frameCenter + sideOffset;
  int error = lineCenter - target;
  int turn = error * 2; 

  setMotor(baseSpeed - turn, baseSpeed + turn);
}

int16_t readRawGyroZ() {
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x21); Wire.endTransmission();
  Wire.requestFrom(ITG3205_ADDR, 2);
  if (Wire.available() == 2) {
    return (Wire.read() << 8 | Wire.read());
  }
  return 0;
}

void setMotor(int left, int right) {
  digitalWrite(IN1, left >= 0 ? HIGH : LOW);
  digitalWrite(IN2, left >= 0 ? LOW : HIGH);
  digitalWrite(IN3, right >= 0 ? HIGH : LOW);
  digitalWrite(IN4, right >= 0 ? LOW : HIGH);
  analogWrite(ENA, constrain(abs(left), 0, 255));
  analogWrite(ENB, constrain(abs(right), 0, 255));
}

void handleWiFiClient() {
  WiFiClient client = server.available();
  if (!client) return;
  
  String currentLine = "";
  while (client.connected()) {
    if (client.available()) {
      char c = client.read();
      if (c == '\n') {
        if (currentLine.length() == 0) {
            sendCounter++;   // sending data with counter
          // Send HTTP Headers with proper CRLF (\r\n)
          client.print("HTTP/1.1 200 OK\r\n");
          client.print("Content-Type: text/html\r\n");
          client.print("Connection: close\r\n");
          client.print("\r\n"); // MANDATORY EMPTY LINE for MATLAB

          // Send HTML Body
          client.print("<html><body>");
          client.print("<h1>Alphabot </h1>");
          client.print("<p>Send Counter: " + String(sendCounter) + "</p>"); // Counter
          client.print("<p>Yaw Rate:</b> " + String(currentYawRate, 2) + "</p>");
          client.print("<p>Yaw Angle:</b> " + String(yawAngle, 2) + "</p>");
          client.print("</body></html>\r\n");
          break;
        } else { currentLine = ""; }
      } else if (c != '\r') { currentLine += c; }
    }
  }
  delay(0); 
  client.stop();
}
