#include <Wire.h>
#include <Pixy2I2C.h>
#include <SoftwareSerial.h>

Pixy2I2C pixy;

// Motor pins for AlphaBot
#define PWMA   6
#define AIN2   A0
#define AIN1   A1
#define PWMB   5
#define BIN1   A2
#define BIN2   A3

// GY-85 (HMC5883L inside)
#define HMC_ADDR 0x1E

float lastHeading = 0;
float lastYawRate = 0;
float yawAngle = 0;  // cumulative yaw angle
unsigned long lastTime = 0;

const float alpha = 0.2;    // low-pass filter for yaw rate
const float deadband = 1.0; // ignore tiny heading changes

// Bluetooth on pins 10 (RX) and 11 (TX)
SoftwareSerial BT(10, 11); // RX, TX

void setup() {
  Serial.begin(115200);   // USB monitor
  BT.begin(9600);         // Bluetooth baud

  Wire.begin();

  pixy.init();
  pixy.changeProg("line");

  pinMode(PWMA, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  // Initialize magnetometer
  Wire.beginTransmission(HMC_ADDR);
  Wire.write(0x00);
  Wire.write(0x70);
  Wire.endTransmission();

  Wire.beginTransmission(HMC_ADDR);
  Wire.write(0x01);
  Wire.write(0xA0);
  Wire.endTransmission();

  Wire.beginTransmission(HMC_ADDR);
  Wire.write(0x02);
  Wire.write(0x00);
  Wire.endTransmission();

  lastTime = millis();
  Serial.println("SYSTEM_READY");
}

void setMotor(int leftSpeed, int rightSpeed) {
  // LEFT motor
  if (leftSpeed >= 0) { digitalWrite(AIN1,HIGH); digitalWrite(AIN2,LOW); }
  else { digitalWrite(AIN1,LOW); digitalWrite(AIN2,HIGH); }
  analogWrite(PWMA, abs(leftSpeed));

  // RIGHT motor
  if (rightSpeed >= 0) { digitalWrite(BIN1,HIGH); digitalWrite(BIN2,LOW); }
  else { digitalWrite(BIN1,LOW); digitalWrite(BIN2,HIGH); }
  analogWrite(PWMB, abs(rightSpeed));
}

void loop() {
  // -------- PIXY LINE TRACKING --------
  pixy.line.getMainFeatures();
  int error = 0;
  bool lineDetected = false;

  if (pixy.line.numVectors) {
    int x0 = pixy.line.vectors[0].m_x0;
    int x1 = pixy.line.vectors[0].m_x1;
    int lineCenter = (x0 + x1)/2;
    int frameCenter = 39;
    error = lineCenter - frameCenter;
    lineDetected = true;
  }

  int leftSpeed = 0;
  int rightSpeed = 0;
  if (lineDetected) {
    int baseSpeed = 120;
    int turn = error * 2;
    leftSpeed  = constrain(baseSpeed - turn, 0, 255);
    rightSpeed = constrain(baseSpeed + turn, 0, 255);
  }
  setMotor(leftSpeed, rightSpeed);

  // -------- GY-85 MAGNETOMETER --------
  int16_t X, Y, Z;
  Wire.beginTransmission(HMC_ADDR);
  Wire.write(0x03);
  Wire.endTransmission();
  Wire.requestFrom(HMC_ADDR, 6);
  if (Wire.available() == 6) {
    X = Wire.read()<<8 | Wire.read();
    Z = Wire.read()<<8 | Wire.read();
    Y = Wire.read()<<8 | Wire.read();
  } else { return; }

  float heading = atan2((float)Y,(float)X) * 180.0 / 3.14159;
  if (heading < 0) heading += 360;

  unsigned long now = millis();
  float dt = (now - lastTime)/1000.0;
  lastTime = now;

  float delta = heading - lastHeading;
  if (delta > 180) delta -= 360;
  if (delta < -180) delta += 360;
  if (abs(delta) < deadband) delta = 0;

  float yawRateRaw = delta / dt;
  float yawRate = alpha * yawRateRaw + (1-alpha)*lastYawRate;

  // Complementary filter for yaw angle
  yawAngle = 0.98*(yawAngle + yawRate*dt) + 0.02*heading;

  // Wrap yaw angle 0–360
  yawAngle = fmod(yawAngle,360.0);
  if(yawAngle<0) yawAngle += 360.0;

  lastHeading = heading;
  lastYawRate = yawRate;

  // -------- Send data --------
  String output = "Heading: "+String(heading,2)+
                  " | YawAngle: "+String(yawAngle,2)+
                  " | YawRateGyro: "+String(yawRate,2)+
                  " | LineError: "+String(error)+
                  " | LeftPower: "+String(leftSpeed)+
                  " | RightPower: "+String(rightSpeed);

  Serial.println(output); // USB
  BT.println(output);     // Bluetooth

  delay(50); // ~20Hz
}
