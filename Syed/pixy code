#include <Pixy2I2C.h>

Pixy2I2C pixy;

// Motor pins
#define PWMA   6
#define AIN2   A0
#define AIN1   A1
#define PWMB   5
#define BIN1   A2
#define BIN2   A3

void setup() {
  Serial.begin(115200);

  pixy.init();
  pixy.changeProg("line");

  pinMode(PWMA, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);

  pinMode(PWMB, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  Serial.println("Ready");
}

// ✅ FORWARD IS NOW REVERSED IN HARDWARE
void setMotor(int leftSpeed, int rightSpeed) {

  // LEFT motor (REVERSED LOGIC)
  if (leftSpeed >= 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  } else {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
  }
  analogWrite(PWMA, abs(leftSpeed));

  // RIGHT motor (REVERSED LOGIC)
  if (rightSpeed >= 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  } else {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
  }
  analogWrite(PWMB, abs(rightSpeed));
}

void loop() {
  pixy.line.getMainFeatures();

  if (pixy.line.numVectors) {

    int x0 = pixy.line.vectors[0].m_x0;
    int x1 = pixy.line.vectors[0].m_x1;

    int lineCenter = (x0 + x1) / 2;
    int frameCenter = 39;

    int error = lineCenter - frameCenter;

    int baseSpeed = 120;
    int turn = error * 2;

    int leftSpeed  = baseSpeed - turn;
    int rightSpeed = baseSpeed + turn;

    leftSpeed  = constrain(leftSpeed, 0, 255);
    rightSpeed = constrain(rightSpeed, 0, 255);

    setMotor(leftSpeed, rightSpeed);

    Serial.print("Error: ");
    Serial.println(error);

  } else {
    setMotor(0, 0);
    Serial.println("No line");
  }

  delay(50);
}
