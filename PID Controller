#include <WiFiS3.h>
#include <Wire.h>
#include <Pixy2I2C.h>

// WiFi Credentials
char ssid[] = "AutonomeSysteme";
char pass[] = "Kennwort1";

// Networking Definitions
IPAddress local_IP(192, 168, 1, 23);
IPAddress gateway(192, 168, 1, 1);
IPAddress subnet(255, 255, 255, 0);

WiFiServer server(5000); 
WiFiClient matlabClient;

// Hardware Pins & Sensors
Pixy2I2C pixy;
#define ITG3205_ADDR 0x68
#define ENA 5
#define ENB 6
#define IN1 A1
#define IN2 A0
#define IN3 A2
#define IN4 A3

// Pixy camera and speed control
int baseSpeed = 160;
int sideOffset = 24;
const int frameCenter = 39; 

// PID Constants 
float Kp = 1.0; 
float Ki = 0.0; 
float Kd = 0.0; 

// PID State
int lastError = 0;
float integral = 0;

// Gyro & Timing
float yawAngle = 0;
float currentYawRate = 0;
float gyroOffsetZ = 0;
unsigned long lastMicros = 0;
unsigned long sendCounter = 0;
unsigned long lastWiFiMillis = 0; 

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  // 1. Initialize Gyro (ITG3205)
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x3E); Wire.write(0x00); Wire.endTransmission();
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x16); Wire.write(0x1D); Wire.endTransmission();

  // 2. Calibrate Gyro (Robot must be stationary)
  Serial.println("Calibrating Gyro... Do not move the AlphaBot");
  long sumZ = 0;
  for (int i = 0; i < 500; i++) { 
    sumZ += readRawGyroZ(); 
    delay(2); 
  }
  gyroOffsetZ = sumZ / 500.0;
  Serial.println("Calibration Done.");

  // 3. Initialize Pixy & Motors
  pixy.init();
  pixy.changeProg("line");
  pinMode(ENA, OUTPUT); pinMode(ENB, OUTPUT);
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);

  // 4. Set Fixed IP and Start WiFi
  // On UNO R4 WiFi, config() returns void, so we call it directly
  WiFi.config(local_IP, gateway, subnet);
  
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);
  
  WiFi.begin(ssid, pass);
  while (WiFi.status() != WL_CONNECTED) { 
    delay(500); 
    Serial.print(".");
  }
  
  server.begin();
  lastMicros = micros();
  Serial.println("\nWireless TCP Server Ready at 192.168.1.23:5000");
}

void loop() {
  calculatePassiveGyro();
  followLine();
  
  // Handle TCP Connection
  if (!matlabClient || !matlabClient.connected()) {
    matlabClient = server.accept(); 
    if (matlabClient) {
      Serial.println("MATLAB Client Connected");
    }
  }

  // Send data every 20ms (50Hz) to MATLAB
  if (matlabClient && matlabClient.connected()) {
    if (millis() - lastWiFiMillis > 10) {
      lastWiFiMillis = millis();
      matlabClient.print(currentYawRate);
      matlabClient.print(",");
      matlabClient.print(yawAngle);
      matlabClient.print(",");
      matlabClient.println(sendCounter++); 
    }
  }
}

void calculatePassiveGyro() {
  unsigned long now = micros();
  float dt = (now - lastMicros) / 1000000.0;
  lastMicros = now;

  // Sensitivity for ITG3205 is 14.375 LSB per degree/sec
  currentYawRate = (readRawGyroZ() - gyroOffsetZ) / 14.375;
  yawAngle += currentYawRate * dt;
}

void followLine() {
  pixy.line.getMainFeatures();
  
  if (pixy.line.numVectors <= 0) { 
    setMotor(0, 0); 
    return; 
  }

  // FIXED: Access vectors through the array index [0]
  int x0 = pixy.line.vectors[0].m_x0;
  int x1 = pixy.line.vectors[0].m_x1;
  int lineCenter = (x0 + x1) / 2;
  
  int target = frameCenter + sideOffset;
  int error = lineCenter - target;

  // PID Math
  float P = error;
  integral = constrain(integral + error, -50, 50); // Constrain to prevent windup
  float D = error - lastError;
  
  int turn = (Kp * P) + (Ki * integral) + (Kd * D);
  lastError = error;

  setMotor(baseSpeed - turn, baseSpeed + turn);
}

int16_t readRawGyroZ() {
  Wire.beginTransmission(ITG3205_ADDR);
  Wire.write(0x21); Wire.endTransmission();
  Wire.requestFrom(ITG3205_ADDR, 2);
  if (Wire.available() == 2) {
    return (Wire.read() << 8 | Wire.read());
  }
  return 0;
}

void setMotor(int left, int right) {
  digitalWrite(IN1, left >= 0 ? HIGH : LOW);
  digitalWrite(IN2, left >= 0 ? LOW : HIGH);
  digitalWrite(IN3, right >= 0 ? HIGH : LOW);
  digitalWrite(IN4, right >= 0 ? LOW : HIGH);
  analogWrite(ENA, constrain(abs(left), 0, 255));
  analogWrite(ENB, constrain(abs(right), 0, 255));
}
